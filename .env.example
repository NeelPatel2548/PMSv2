# ==========================================================================
# PMS — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ==========================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5000
NODE_ENV=development           # Set to 'production' on your hosting platform

# ---------------------------------------------------------------------------
# Database — MongoDB Atlas
# ---------------------------------------------------------------------------
# How to get your connection string:
#   1. Go to https://cloud.mongodb.com → Your Project → Database
#   2. Click "Connect" on your cluster → "Drivers" → Node.js
#   3. Copy the connection string and replace <username> / <password>
#
# Full format:
#   mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority&appName=PMS
#
# Atlas setup checklist:
#   • Network Access → Add IP Address → 0.0.0.0/0 (Allow from anywhere)
#     This is safe because access is credential-controlled, not IP-controlled.
#     Cloud platforms (Render, Railway, Fly.io) have dynamic IPs — allowlisting
#     a specific IP will cause random connection failures after redeploys.
#   • Database Access → Add database user → role: readWriteAnyDatabase
#   • Recommended tier: M0 (free) is sufficient for a college PMS
#     Upgrade to M10 only if you exceed 512MB storage or need >100 connections.
#
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/pms?retryWrites=true&w=majority&appName=PMS

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# JWT_SECRET should be a long random string (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_min_32_chars
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Email — Gmail App Password
# ---------------------------------------------------------------------------
# To generate a Gmail App Password:
#   1. Enable 2FA on the Gmail account
#   2. Go to Google Account → Security → App Passwords
#   3. Create a new app password for "Mail" / "Other"
#   4. Use the 16-character password below (spaces are OK)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
# Development: http://localhost:5173
# Production:  https://your-frontend.onrender.com (or your deployed URL)
CLIENT_URL=http://localhost:5173
VITE_API_URL=http://localhost:5000/api

# ---------------------------------------------------------------------------
# OTP Bypass — DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# Remove these entirely (or set BYPASS_OTP=false) in production.
BYPASS_OTP=true
BYPASS_OTP_CODE=SKIP2025

# ---------------------------------------------------------------------------
# Cloudinary — File / Resume Storage
# ---------------------------------------------------------------------------
# Get from: https://console.cloudinary.com/settings/api-keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret